# ─────────────────────────────────────────
#  ReelSnap Frontend — Environment Config
#  Copy to .env and fill values
# ─────────────────────────────────────────

# Backend API base URL (no trailing slash)
REELSNAP_API_BASE_URL=http://localhost:8000

# Site name shown in UI
REELSNAP_SITE_NAME=ReelSnap

# Optional: Google Analytics ID
REELSNAP_GA_ID=
